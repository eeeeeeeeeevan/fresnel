#!/bin/sh
# detect: prints 0 (clean) or 1 (rootkit) and exits with the same value
# strong = never seen on a clean host, one is enough
# weak = could be innocent, takes two different kinds

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
umask 077

# keep real stdout on fd 3 for the answer, bin everything else
exec 3>&1 >/dev/null 2>&1

verdict() {
	echo "$1" >&3
	exit "$1"
}

strong() {
	verdict 1
}

WEAK=" "
weak() {
	case "$WEAK" in *" $1 "*) return ;; esac
	WEAK="$WEAK$1 "
	[ "$(echo $WEAK | wc -w)" -ge 2 ] && verdict 1
}

listed() {
	ls -a "$1" | grep -qxF -- "$2"
}

CANARIES="rootkit.ko rk.ko rootkit rootkit_lab.ko rk_core.ko kelevate.ko
privesc.ko hiding.ko elevate.ko frk.ko sys_drv.ko rkmod.ko cockatoo.ko
elevate install remote log controller priv_esc daemon log.txt remote.ip
rkx .rk_probe rootkit_probe fbrk_probe Makefile export_syms module
.elevate_bin .remote_ip rk.conf hide_kld revshell kelevate opt_global.h
.sysfifo rootkit_remote_ip"

HERE=$(cd "$(dirname "$0")" && pwd)
WORK=$(mktemp -d /tmp/detect.XXXXXX) || verdict 0
C=$WORK/canary

# rm -rf lists the dir to empty it, so it cant see canaries a kit is
# hiding. unlink them by name first
cleanup() {
	for n in zz_control $CANARIES; do rm -f "$C/$n"; done
	rm -rf "$WORK"
}
trap cleanup EXIT
trap 'verdict 0' INT TERM

# canaries: make files with names kits hide, then see if ls shows them
mkdir "$C"
for n in zz_control $CANARIES; do : > "$C/$n"; done
ls -a "$C" > "$WORK/listing"
if grep -qxF zz_control "$WORK/listing"; then
	for n in $CANARIES; do
		[ -e "$C/$n" ] && ! grep -qxF -- "$n" "$WORK/listing" && strong
	done
fi

# known artefacts, looked up by path which a getdirentries hook doesnt touch
while read -r level p; do
	[ -e "$p" ] || [ -L "$p" ] || continue
	listed "$(dirname "$p")" "$(basename "$p")" || strong
	$level artefact
done <<EOF
strong /dev/elevate_dev
strong /dev/rk
strong /dev/rootkit
strong /dev/rkx
strong /dev/cd_example
strong /boot/modules/rk.ko
strong /boot/modules/rootkit.ko
strong /boot/modules/rootkit_lab.ko
strong /boot/modules/privesc.ko
strong /boot/modules/rk_core.ko
strong /boot/modules/.rk_rootkit.ko
strong /boot/modules/kelevate.ko
strong /boot/modules/elevate.ko
strong /boot/modules/frk.ko
strong /boot/kernel/elevate.ko
strong /boot/kernel/rootkit.ko
strong /boot/kernel/rk.ko
strong /usr/local/lib/rk
strong /usr/lib/rk
strong /etc/rk.conf
strong /etc/rootkit_remote_ip
strong /usr/local/bin/revshell
strong /usr/local/bin/elevate
strong /sbin/controller
strong /bin/priv_esc
strong /tmp/.sysfifo
strong /etc/install
weak /tmp/cockatoo
weak /log.txt
weak /tmp/rkbuild.log
EOF

for s in kern.sched.preempt_threshold kern.escalate_offset debug.frk_hide; do
	sysctl -N "$s" && strong
done
ps -axo comm= | grep -qxE 'revshell|hide_kld' && strong
dmesg | grep -qiE 'rootkit|KEYLOG:' && weak dmesg

# boot persistence
BAD='(rk|rk_core|rkx|rkmod|frk|kelevate|privesc|elevate|cockatoo|sys_drv|hiding|rootkit[a-z0-9_]*)'

LOADERS=""
for f in /boot/loader.conf /boot/loader.conf.local /boot/loader.conf.d/*.conf; do
	[ -f "$f" ] && LOADERS="$LOADERS $f"
done
for f in $LOADERS; do
	grep -qiE "^[[:space:]]*${BAD}_(load|name|type|flags)[[:space:]]*=" "$f" && strong
	grep -qE '_name[[:space:]]*=.*/\.rk_' "$f" && strong
done

KLDLIST=$(sysrc -n -q kld_list)
for t in $KLDLIST; do
	basename "$t" .ko | grep -qxE "$BAD|\.rk_.*" && strong
done

[ -f /etc/rc.local ] && grep -qE 'hide_kld|rootkit' /etc/rc.local && strong
for f in /var/cron/tabs/root /etc/crontab; do
	[ -f "$f" ] && grep -qE '/etc/install|rootkit' "$f" && strong
done

# boot config loads it and the file is there but nothing can find it loaded.
# weak cos the config might just have changed since boot
CFGMODS=$KLDLIST
for f in $LOADERS; do
	CFGMODS="$CFGMODS $(sed -nE 's/^[[:space:]]*([A-Za-z0-9_]+)_load[[:space:]]*=[[:space:]]*"?[Yy][Ee][Ss]"?.*/\1/p' "$f")"
done
for t in $CFGMODS; do
	m=$(basename "$t" .ko)
	for d in /boot/kernel /boot/modules "$(dirname "$t")"; do
		[ -f "$d/$m.ko" ] || continue
		kldstat -q -n "$m.ko" || kldstat -q -n "$m" || kldstat -q -m "$m" ||
			weak config-unloaded
		break
	done
done

# kernel checks, built on the target so it matches its headers
if cc -O1 -w -o "$WORK/kprobe" "$HERE/kprobe.c" -lkvm -lprocstat; then
	timeout 120 "$WORK/kprobe" > "$WORK/kprobe.out"
	while read -r level check; do
		case "$level" in
		STRONG)	strong ;;
		WEAK)	weak "$check" ;;
		esac
	done < "$WORK/kprobe.out"
else
	# no compiler, at least ask for kit modules by name
	for m in rk rk_core kelevate privesc elevate frk cockatoo sys_drv rkmod \
	    rootkit rootkit_lab sys/privesc sys/kld_hiding; do
		kldstat -q -m "$m" && strong
		kldstat -q -n "$m.ko" && strong
	done
fi

verdict 0
